+#include <common.h>
+#include <syscall.h>
+#include "../clipdraw_internal.h"
+
+#define CD_SYSCALL_ENTRY(name)  [SYS_##name - SYSCALL_BASE(SYSCALL_RANGE_CD)] = Sys##name,
+
+static const ke_syscall_handler_t cd_syscall_table[] = {
+    CD_SYSCALLS(CD_SYSCALL_ENTRY)
