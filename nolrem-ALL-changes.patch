diff --git a/kernel/include/harderror.h b/kernel/include/harderror.h
new file mode 100644
index 0000000..ef6cf06
--- /dev/null
+++ b/kernel/include/harderror.h
@@ -0,0 +1,26 @@
+#pragma once
+
+/*
+ * Hard errors: conditions the kernel cannot continue past without the user's
+ * help (e.g. out of memory in the middle of a page fault).
+ *
+ * The kernel itself has no user interface, so it only owns the hook. Whichever
+ * component can put a message in front of the user (the window manager)
+ * registers a handler with KeSetHardErrorHandler(). With no handler registered,
+ * KeHardError() fails straight away and the caller does whatever it does when
+ * recovery is impossible (normally a panic).
+ */
+
+/*
+ * Called with the errno describing the problem (ENOMEM, EIO, ...). Returns 0 if
+ * the problem has been dealt with and the caller should retry the operation,
+ * or a non-zero errno if the caller should give up. May block, and may never
+ * return at all if the user has to intervene.
+ */
+typedef int (*ke_hard_error_handler_t)(int herrno);
+
+/* Passing NULL removes the handler. */
+void KeSetHardErrorHandler(ke_hard_error_handler_t handler);
+
+/* Returns 0 if the caller should retry, non-zero if there is nothing to be done. */
+int KeHardError(int herrno);
diff --git a/kernel/include/input.h b/kernel/include/input.h
new file mode 100644
index 0000000..5bf7d3c
--- /dev/null
+++ b/kernel/include/input.h
@@ -0,0 +1,24 @@
+#pragma once
+
+#include <stdint.h>
+
+/*
+ * Input device -> consumer plumbing.
+ *
+ * Device drivers report what the hardware did with the KeReport...() functions,
+ * and have no idea who is listening. Whichever component consumes input (the
+ * window manager) registers a handler with the matching KeSet...Handler().
+ * Input that arrives while nobody is registered is dropped.
+ *
+ * Handlers are called straight from the driver's interrupt handler, so they
+ * must be IRQ-safe: no blocking, no heap allocation.
+ */
+
+/* click_bits: bit 0 = left, bit 1 = right, bit 2 = middle. */
+typedef void (*ke_mouse_handler_t)(uint8_t click_bits, int16_t delta_x, int16_t delta_y,
+                                   int scroll_x, int scroll_y);
+
+/* Passing NULL removes the handler. */
+void KeSetMouseHandler(ke_mouse_handler_t handler);
+void KeReportMouseInput(uint8_t click_bits, int16_t delta_x, int16_t delta_y,
+                        int scroll_x, int scroll_y);
